<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.resteasy.vertx</groupId>
        <artifactId>resteasy-vertx-parent</artifactId>
        <version>2.0.0.Beta3-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>resteasy-vertx-integration-tests</artifactId>
    <packaging>jar</packaging>

    <name>RESTEasy Vert.x Integration Tests</name>
    <description>
        Black-box tests that consume the published modules on the module path to validate the module descriptors as an end user experiences them.
        This module produces no shipped artifact.
    </description>

    <properties>
        <!-- Test-only module; nothing to publish -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <central.skipPublishing>true</central.skipPublishing>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.resteasy.vertx</groupId>
                <artifactId>resteasy-vertx-project-bom</artifactId>
                <version>2.0.0.Beta3-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>dev.resteasy.vertx</groupId>
                <artifactId>resteasy-vertx-test-bom</artifactId>
                <version>2.0.0.Beta3-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The module under test, plus everything it brings transitively (api, vert.x, resteasy-core). -->
        <dependency>
            <groupId>dev.resteasy.vertx</groupId>
            <artifactId>resteasy-vertx-cdi</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.resteasy.vertx</groupId>
            <artifactId>resteasy-vertx-embedded-server</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.resteasy.vertx</groupId>
            <artifactId>resteasy-vertx-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.resteasy.junit.extension</groupId>
            <artifactId>resteasy-junit-extension</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      Weld generates CDI client proxies for normal-scoped producers of Vert.x types
                      (RoutingContext, Router). On the module path each proxy is defined into the type's own
                      package, so Weld needs that package opened (to define the class) and the owning module
                      needs to read weld.core.impl (so the defined proxy can link its Weld superinterfaces,
                      e.g. LifecycleMixin/WeldClientProxy). jakarta.* and java.* types avoid this because Weld
                      relocates their proxies into its own module; foreign types like io.vertx.* do not.

                      The reads for the org.jboss.cdi module can be removed once https://redhat.atlassian.net/browse/RESTEASY-3794
                      is resolved.
                    -->
                    <argLine>
                        --add-opens io.vertx.core/io.vertx.core=weld.core.impl
                        --add-opens io.vertx.web/io.vertx.ext.web=weld.core.impl
                        --add-reads io.vertx.core=weld.core.impl
                        --add-reads io.vertx.web=weld.core.impl
                        --add-reads io.vertx.core=weld.api
                        --add-reads io.vertx.web=weld.api
                        --add-reads org.jboss.resteasy.cdi=weld.api
                        --add-reads org.jboss.resteasy.cdi=weld.core.impl
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
